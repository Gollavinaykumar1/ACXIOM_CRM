@model IEnumerable<FollowUp>
<div class="pagehead"><div><div class="eyebrow">CUSTOMER ENGAGEMENT</div><h1>Follow-ups</h1><div class="muted">Plan, complete and track customer interactions.</div></div><a asp-action="Create" class="btn btn-primary">+ Schedule follow-up</a></div><div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Subject</th><th>Date</th><th>Related</th><th>Assigned to</th><th>Status</th><th>Update</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Subject</td><td>@x.FollowUpDate.ToString("dd MMM yyyy")</td><td>@x.RelatedType #@x.RelatedId</td><td>@x.AssignedUser?.FullName</td><td>@x.Status</td><td><form asp-action="Status" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@x.Id"/><select name="status" class="form-select form-select-sm"><option value="Planned" selected="@(x.Status=="Planned" ? "selected" : null)">Planned</option><option value="Completed" selected="@(x.Status=="Completed" ? "selected" : null)">Completed</option><option value="Missed" selected="@(x.Status=="Missed" ? "selected" : null)">Missed</option><option value="Cancelled" selected="@(x.Status=="Cancelled" ? "selected" : null)">Cancelled</option></select><button class="btn btn-sm btn-outline-secondary">Save</button></form></td></tr>}</tbody></table></div>
