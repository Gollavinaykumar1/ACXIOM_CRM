@model FollowUp
<div class="pagehead"><div><div class="eyebrow">CUSTOMER ENGAGEMENT</div><h1>Schedule follow-up</h1></div></div><div class="panel col-lg-8"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control mb-3"/><label asp-for="FollowUpDate" class="form-label"></label><input asp-for="FollowUpDate" type="date" class="form-control mb-3"/><label asp-for="RelatedType" class="form-label"></label><select asp-for="RelatedType" class="form-select mb-3"><option>Customer</option><option>Lead</option><option>Opportunity</option></select><label asp-for="RelatedId" class="form-label">Related record ID (optional)</label><input asp-for="RelatedId" class="form-control mb-3"/><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control mb-3"></textarea><button class="btn btn-primary">Save follow-up</button></form></div>
