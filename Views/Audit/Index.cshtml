@model IEnumerable<AuditLog>
<div class="pagehead"><div><div class="eyebrow">SECURITY & GOVERNANCE</div><h1>Audit trail</h1><div class="muted">Append-oriented record of security and business activity.</div></div></div><div class="panel table-responsive"><table class="table"><thead><tr><th>Time</th><th>User</th><th>Module</th><th>Action</th><th>Record</th><th>Result</th><th>Details</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Timestamp.ToLocalTime().ToString("g")</td><td>@x.UserName</td><td>@x.Module</td><td>@x.Action</td><td>@x.RecordId</td><td>@x.Result</td><td>@x.Details</td></tr>}</tbody></table></div>
