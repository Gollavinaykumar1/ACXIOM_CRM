@model LoginVm
<div class="authcard"><div class="brandmark mb-3">A</div><div class="eyebrow">WELCOME TO YOUR WORKSPACE</div><h2 class="fw-bold mt-2">Sign in to AcxiomCRM</h2><p class="muted">Your customer relationships are one step away.</p><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div><input type="hidden" asp-for="ReturnUrl"/><label asp-for="Email" class="form-label">Work email</label><input asp-for="Email" class="form-control mb-3"/><span asp-validation-for="Email" class="text-danger"></span><label asp-for="Password" class="form-label">Password</label><div class="password-wrap mb-3"><input asp-for="Password" class="form-control" id="loginPassword"/><button type="button" class="password-toggle" data-toggle-password="loginPassword">Show</button></div><div class="form-check mb-3"><input asp-for="RememberMe" class="form-check-input"/><label asp-for="RememberMe" class="form-check-label">Remember me</label></div><button class="btn btn-primary w-100">Sign in to workspace →</button></form><p class="text-center mt-3 mb-0">New to AcxiomCRM? <a asp-action="Register">Create an account</a></p><div class="panel mt-4"><b>DEMO ACCESS</b><div class="small mt-2">Admin: admin@acxiomcrm.demo / Admin@123</div><div class="small">Manager: manager@acxiomcrm.demo / Manager@123</div><div class="small">Sales: sales@acxiomcrm.demo / Sales@123</div></div></div>
