@model IEnumerable<Customer>
<div class="pagehead"><div><div class="eyebrow">CUSTOMER INTELLIGENCE</div><h1>Customers</h1><div class="muted">Manage customer relationships and account details.</div></div><a asp-action="Create" class="btn btn-primary">+ Add customer</a></div><div class="panel"><form method="get" class="d-flex gap-2 mb-3"><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search name or email"/><button class="btn btn-outline-secondary">Search</button></form><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Customer</th><th>Email</th><th>Phone</th><th>Status</th><th>Owner</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.Name</b></td><td>@x.Email</td><td>@x.Phone</td><td><span class="badge-soft">@x.Status</span></td><td>@x.Owner?.FullName</td><td>@if(User.IsInRole("Admin")||User.IsInRole("Manager")||x.OwnerId==User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value){<a asp-action="Edit" asp-route-id="@x.Id">Edit</a>}</td></tr>}</tbody></table></div></div>
