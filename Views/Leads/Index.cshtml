@model IEnumerable<Lead>
<div class="pagehead"><div><div class="eyebrow">SALES DEVELOPMENT</div><h1>Leads</h1><div class="muted">Capture, qualify, assign and convert prospective customers.</div></div><a asp-action="Create" class="btn btn-primary">+ Add lead</a></div><div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Lead</th><th>Source</th><th>Status</th><th>Priority</th><th>Owner</th><th>Workflow</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.Name</b><div class="muted small">@x.Email</div></td><td>@x.Source</td><td>@x.Status</td><td>@x.Priority</td><td>@x.Owner?.FullName</td><td><form asp-action="ChangeStatus" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@x.Id"/><select name="status" class="form-select form-select-sm"><option value="New" selected="@(x.Status=="New" ? "selected" : null)">New</option><option value="Contacted" selected="@(x.Status=="Contacted" ? "selected" : null)">Contacted</option><option value="Qualified" selected="@(x.Status=="Qualified" ? "selected" : null)">Qualified</option><option value="Unqualified" selected="@(x.Status=="Unqualified" ? "selected" : null)">Unqualified</option><option value="Lost" selected="@(x.Status=="Lost" ? "selected" : null)">Lost</option></select><button class="btn btn-sm btn-outline-secondary">Update</button></form>@if(x.Status=="Qualified"){<form asp-action="Convert" method="post" class="mt-1"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-primary">Convert</button></form>}</td></tr>}</tbody></table></div>
