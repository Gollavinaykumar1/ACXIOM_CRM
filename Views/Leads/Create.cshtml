@model Lead
<div class="pagehead"><div><div class="eyebrow">SALES DEVELOPMENT</div><h1>Create lead</h1></div></div><div class="panel col-lg-8"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control mb-3"/><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control mb-3"/><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control mb-3"/><label asp-for="Source" class="form-label"></label><select asp-for="Source" class="form-select mb-3"><option>Website</option><option>Referral</option><option>Social Media</option><option>Event</option><option>Cold Call</option></select><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" class="form-select mb-3"><option>Low</option><option selected>Normal</option><option>High</option></select><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control mb-3"></textarea><button class="btn btn-primary">Save lead</button></form></div>
