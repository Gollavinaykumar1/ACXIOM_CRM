@model IEnumerable<Opportunity>
<div class="pagehead"><div><div class="eyebrow">REVENUE MANAGEMENT</div><h1>Opportunities</h1><div class="muted">Track deal value, probability and pipeline stages.</div></div><a asp-action="Create" class="btn btn-primary">+ Add opportunity</a></div><div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Opportunity</th><th>Customer</th><th>Stage</th><th>Amount</th><th>Probability</th><th>Weighted</th><th>Expected close</th><th>Move stage</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.Name</b></td><td>@x.Customer?.Name</td><td>@x.Stage</td><td>@x.Amount.ToString("C0")</td><td>@x.Probability%</td><td>@x.WeightedValue.ToString("C0")</td><td>@x.ExpectedCloseDate.ToString("dd MMM yyyy")</td><td><form asp-action="Stage" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@x.Id"/><select name="stage" class="form-select form-select-sm"><option value="Qualification" selected="@(x.Stage=="Qualification" ? "selected" : null)">Qualification</option><option value="Proposal" selected="@(x.Stage=="Proposal" ? "selected" : null)">Proposal</option><option value="Negotiation" selected="@(x.Stage=="Negotiation" ? "selected" : null)">Negotiation</option><option value="Won" selected="@(x.Stage=="Won" ? "selected" : null)">Won</option><option value="Lost" selected="@(x.Stage=="Lost" ? "selected" : null)">Lost</option></select><button class="btn btn-sm btn-outline-secondary">Save</button></form></td></tr>}</tbody></table></div>
