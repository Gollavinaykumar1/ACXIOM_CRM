@model Opportunity
<div class="pagehead"><div><div class="eyebrow">REVENUE MANAGEMENT</div><h1>Create opportunity</h1></div></div><div class="panel col-lg-8"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control mb-3"/><label asp-for="CustomerId" class="form-label">Customer</label><select asp-for="CustomerId" class="form-select mb-3" asp-items="@(new SelectList((IEnumerable<Customer>)ViewBag.Customers,"Id","Name"))"><option value="">Select customer</option></select><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control mb-3"/><label asp-for="Probability" class="form-label"></label><input asp-for="Probability" class="form-control mb-3"/><label asp-for="ExpectedCloseDate" class="form-label"></label><input asp-for="ExpectedCloseDate" type="date" class="form-control mb-3"/><button class="btn btn-primary">Save opportunity</button></form></div>
