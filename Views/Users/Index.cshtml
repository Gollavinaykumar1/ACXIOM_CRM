@model IEnumerable<ApplicationUser>
<div class="pagehead"><div><div class="eyebrow">ADMINISTRATION</div><h1>User access</h1><div class="muted">Manage account activation and access status.</div></div></div><div class="panel table-responsive"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.FullName</td><td>@x.Email</td><td>@(x.IsActive?"Active":"Inactive")</td><td><form asp-action="Toggle" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-secondary">@(x.IsActive?"Deactivate":"Activate")</button></form></td></tr>}</tbody></table></div>
