<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>AcxiomCRM — Intelligent Sales</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="~/css/site.css" rel="stylesheet"/></head><body>
@if(User.Identity?.IsAuthenticated==true){<aside class="sidebar"><a class="brand" asp-controller="Dashboard" asp-action="Index"><span class="brandmark">A</span><span><b>ACXIOMCRM</b><small>INTELLIGENT SALES OS</small></span></a><div class="navlabel">WORKSPACE</div><nav><a asp-controller="Dashboard" asp-action="Index">▦　Overview</a><a asp-controller="Customers" asp-action="Index">♟　Customers</a><a asp-controller="Leads" asp-action="Index">◎　Leads</a><a asp-controller="Opportunities" asp-action="Index">◇　Opportunities</a><a asp-controller="FollowUps" asp-action="Index">◷　Follow-ups</a><a asp-controller="Audit" asp-action="Index">↗　Audit trail</a><a asp-controller="Reports" asp-action="Index">▤　Reports</a>@if(User.IsInRole("Admin")){<a asp-controller="Users" asp-action="Index">♧　User access</a>}</nav><div class="sideuser"><b>@(User.Identity?.Name)</b><small>@(User.IsInRole("Admin")?"Admin":User.IsInRole("Manager")?"Manager":"Sales Executive")</small><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-light mt-2">Sign out</button></form></div></aside>}
<main class="@(User.Identity?.IsAuthenticated==true?"main":"authmain")">@if(User.Identity?.IsAuthenticated==true){<header class="topbar"><span>Workspace　/　<b>@ViewContext.RouteData.Values["controller"]</b></span><span class="userchip">@User.Identity?.Name</span></header>}<section class="content">@if(TempData["Success"]!=null){<div class="alert alert-success alert-dismissible fade show toastmsg">@TempData["Success"]<button class="btn-close" data-bs-dismiss="alert"></button></div>}@RenderBody()</section></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
